#!/usr/bin/env bash
# herdr-sessionizer: pick a project dir with fzf and open it in its own herdr
# workspace, or jump to it if it is already open.
# Works from inside herdr (switches the current client) and from a plain
# terminal (starts the server if needed, then attaches).
#
# Directories come from $HERDR_SESSIONIZER_CONFIG, default
# ${XDG_CONFIG_HOME:-~/.config}/herdr/sessionizer/directories. One path per
# line; a path ending in /* offers its subdirectories instead of itself, and
# "path = name" names the workspace explicitly.
config=${HERDR_SESSIONIZER_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/sessionizer/directories}

directories=()
declare -A labels=() seen=()

add_directory() {
	[[ -n ${seen[$1]} ]] && return
	seen[$1]=1
	directories+=("$1")
}

read_config() {
	local line path label dir
	while IFS= read -r line || [[ -n $line ]]; do
		# trim, skip blanks and comments
		line=${line#"${line%%[![:space:]]*}"}
		line=${line%"${line##*[![:space:]]}"}
		[[ -z $line || $line == \#* ]] && continue

		# "path = name"; the spaces around = are required, so paths may contain =
		label=
		path=$line
		if [[ $line =~ ^(.*[^[:space:]])[[:space:]]+=[[:space:]]+(.+)$ ]]; then
			path=${BASH_REMATCH[1]}
			label=${BASH_REMATCH[2]}
		fi
		[[ $path == "~" || $path == "~/"* ]] && path=$HOME${path:1}

		if [[ $path == */\* ]]; then
			while IFS= read -r dir; do
				add_directory "$dir"
			done < <(find "${path%/\*}" -mindepth 1 -maxdepth 1 -type d -not -name ".*" 2>/dev/null)
		elif [[ -d $path ]]; then
			path=$(realpath "$path")
			add_directory "$path"
			[[ -n $label ]] && labels[$path]=$label
		fi
	done < <(if [[ -f $config ]]; then cat "$config"; else printf '%s\n' '~' '~/*'; fi)
}

read_config

if [[ $# -eq 1 ]]; then
	selected=$1
elif ((${#directories[@]})); then
	selected=$(printf '%s\n' "${directories[@]}" | fzf)
fi

if [[ -z $selected ]]; then
	exit 0
fi
selected=$(realpath "$selected")

if [[ -n ${labels[$selected]} ]]; then
	selected_name=${labels[$selected]}
elif [[ $selected == "$(realpath ~)" ]]; then
	# Match herdr's own label for a workspace sitting in the home dir.
	selected_name="~"
else
	# Same naming as tmux-sessionizer.
	selected_name=$(basename "$selected" | tr . _ | tr ' ' _)
fi

# Outside herdr there may be no server yet. Start one detached, the same way a
# bare `herdr` would, so the workspace exists before we attach.
if [[ $HERDR_ENV != 1 ]] && ! herdr workspace list >/dev/null 2>&1; then
	setsid -f herdr server >/dev/null 2>&1 </dev/null
	for _ in $(seq 50); do
		herdr workspace list >/dev/null 2>&1 && break
		sleep 0.1
	done
fi

workspace_id=$(herdr workspace list | jq -r --arg l "$selected_name" \
	'first(.result.workspaces[] | select(.label == $l) | .workspace_id) // empty')

if [[ -z $workspace_id ]]; then
	herdr workspace create --cwd "$selected" --label "$selected_name" --focus >/dev/null || exit 1
else
	herdr workspace focus "$workspace_id" >/dev/null
fi

# Inside herdr the focus change already switched the client; outside, attach.
if [[ $HERDR_ENV != 1 ]]; then
	exec herdr
fi
