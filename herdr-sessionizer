#!/usr/bin/env bash
# herdr-sessionizer: pick a project dir with fzf and open it in its own herdr
# workspace, or jump to it if it is already open.
# Works from inside herdr (switches the current client) and from a plain
# terminal (starts the server if needed, then attaches).
#
#   herdr-sessionizer              pick a directory and open it
#   herdr-sessionizer DIR          open DIR
#   herdr-sessionizer --print      pick a directory and print it
#   herdr-sessionizer --edit FILE [LINE [COLUMN]]
#                                  open FILE in nvim in its project's workspace,
#                                  in the background
#
# Directories come from $HERDR_SESSIONIZER_CONFIG, default
# ${XDG_CONFIG_HOME:-~/.config}/herdr/sessionizer/directories. One path per
# line; a path with wildcards offers every directory it matches instead, and
# "path = name" names the workspace explicitly.
config=${HERDR_SESSIONIZER_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/sessionizer/directories}

directories=()
declare -A labels=() seen=()

add_directory() {
	[[ -n ${seen[$1]} ]] && return
	seen[$1]=1
	directories+=("$1")
}

# Add each non-hidden directory matching a glob, named after its path from the
# first wildcard on: ~/customers/*/* names ~/customers/acme/api "acme/api".
add_glob() {
	local IFS= base=${1%%[*?[]*} match label i
	local -a matches dirs
	base=${base%/*}
	# a pattern that isn't one, like a lone "[", comes back as-is
	shopt -s nullglob
	for match in $1/; do
		[[ -d $match ]] && matches+=("$match")
	done
	shopt -u nullglob
	((${#matches[@]})) || return
	mapfile -t dirs < <(realpath -- "${matches[@]}")
	for i in "${!matches[@]}"; do
		add_directory "${dirs[i]}"
		label=${matches[i]#"$base"/}
		label=${label%/}
		label=${label//[. ]/_}
		# an explicit "path = name" wins, whichever line comes first
		[[ -z ${labels[${dirs[i]}]} ]] && labels[${dirs[i]}]=$label
	done
}

read_config() {
	local line path label
	while IFS= read -r line || [[ -n $line ]]; do
		# trim, skip blanks and comments
		line=${line#"${line%%[![:space:]]*}"}
		line=${line%"${line##*[![:space:]]}"}
		[[ -z $line || $line == \#* ]] && continue

		# "path = name"; the spaces around = are required, so paths may contain =
		label=
		path=$line
		if [[ $line =~ ^(.*[^[:space:]])[[:space:]]+=[[:space:]]+(.+)$ ]]; then
			path=${BASH_REMATCH[1]}
			label=${BASH_REMATCH[2]}
		fi
		[[ $path == "~" || $path == "~/"* ]] && path=$HOME${path:1}

		if [[ $path == *[*?[]* ]]; then
			add_glob "$path"
		elif [[ -d $path ]]; then
			path=$(realpath "$path")
			add_directory "$path"
			[[ -n $label ]] && labels[$path]=$label
		fi
	done < <(if [[ -f $config ]]; then cat "$config"; else printf '%s\n' '~' '~/*'; fi)
}

# The workspace label for a directory: its name from the directories file, "~"
# for the home dir to match herdr's own label, or else the directory name like
# tmux-sessionizer.
label_for() {
	local name=${1##*/}
	if [[ -n ${labels[$1]} ]]; then
		printf '%s\n' "${labels[$1]}"
	elif [[ $1 == "$(realpath ~)" ]]; then
		printf '%s\n' "~"
	else
		printf '%s\n' "${name//[. ]/_}"
	fi
}

# The workspace directory for a file: the nearest folder above it that the
# directories file lists, else its git root, else the folder it is in.
project_dir() {
	local dir=${1%/*}
	while [[ -n $dir ]]; do
		[[ -n ${seen[$dir]} ]] && printf '%s\n' "$dir" && return
		dir=${dir%/*}
	done
	git -C "${1%/*}" rev-parse --show-toplevel 2>/dev/null || printf '%s\n' "${1%/*}"
}

workspace_id() {
	herdr workspace list | jq -r --arg l "$1" \
		'first(.result.workspaces[] | select(.label == $l) | .workspace_id) // empty'
}

# Outside herdr there may be no server yet. Start one detached, the same way a
# bare `herdr` would, so workspaces can be made before anything attaches.
start_server() {
	[[ $HERDR_ENV == 1 ]] && return
	herdr workspace list >/dev/null 2>&1 && return
	setsid -f herdr server >/dev/null 2>&1 </dev/null
	for _ in $(seq 50); do
		herdr workspace list >/dev/null 2>&1 && break
		sleep 0.1
	done
}

# Open a file in nvim at line $2, column $3, in its project's workspace without
# focusing it: in the first pane of a new workspace, or in a new tab of an open
# one so nothing already running there gets typed into.
edit_file() {
	local file dir label workspace pane command
	file=$(realpath "$1") || return
	dir=$(project_dir "$file")
	label=$(label_for "$dir")
	start_server
	workspace=$(workspace_id "$label")
	if [[ -z $workspace ]]; then
		pane=$(herdr workspace create --cwd "$dir" --label "$label" --no-focus |
			jq -r '.result.root_pane.pane_id // empty')
	else
		pane=$(herdr tab create --workspace "$workspace" --cwd "$dir" --no-focus |
			jq -r '.result.root_pane.pane_id // empty')
	fi
	[[ -n $pane ]] || return
	printf -v command '%q ' nvim "+call cursor($2, $3)" "$file"
	herdr pane run "$pane" "$command" >/dev/null
}

read_config

if [[ $1 == --edit ]]; then
	edit_file "$2" "${3:-1}" "${4:-1}"
	exit
fi

if [[ $# -eq 1 && $1 != --print ]]; then
	selected=$1
elif ((${#directories[@]})); then
	selected=$(printf '%s\n' "${directories[@]}" | fzf)
fi

if [[ -z $selected ]]; then
	exit 0
fi
if [[ $1 == --print ]]; then
	printf '%s\n' "$selected"
	exit
fi
selected=$(realpath "$selected")
selected_name=$(label_for "$selected")

start_server
workspace=$(workspace_id "$selected_name")
if [[ -z $workspace ]]; then
	herdr workspace create --cwd "$selected" --label "$selected_name" --focus >/dev/null || exit 1
else
	herdr workspace focus "$workspace" >/dev/null
fi

# Inside herdr the focus change already switched the client; outside, attach.
if [[ $HERDR_ENV != 1 ]]; then
	exec herdr
fi
