#!/bin/sh
# Pick the first line containing $FZF_PICK, or cancel when it is empty. The
# list it was offered is saved to $FZF_INPUT when that is set.
input=$(cat)
[ -n "$FZF_INPUT" ] && printf '%s\n' "$input" > "$FZF_INPUT"
[ -n "$FZF_PICK" ] || exit 130
printf '%s\n' "$input" | grep -m1 -- "$FZF_PICK"
